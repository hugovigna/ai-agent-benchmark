# =============================================================================
# .gitignore — Fichiers à NE PAS versionner dans Git
# =============================================================================

# --- Fichier d'environnement (credentials) ---
# Le .env contient les mots de passe, clés API, etc.
# Ne JAMAIS le commiter ! Seul .env.example (sans les valeurs) est versionné.
.env

# --- Cache Python ---
# Python crée ces fichiers automatiquement quand on importe des modules.
# Ils accélèrent les imports mais ne doivent pas être versionnés.
__pycache__/
*.pyc

# --- Fichiers macOS ---
# macOS crée des fichiers .DS_Store dans chaque dossier ouvert dans Finder.
.DS_Store

# --- Fichiers de sortie du pipeline ---
# Les données générées par le pipeline (résultats, rapports).
# Ce sont des données dérivées, pas du code source.
data/output/

# --- Fichiers de checkpoint (Challenge 4) ---
# Les checkpoints sont des sauvegardes temporaires du pipeline.
# Ils sont créés et supprimés automatiquement.
checkpoints/

# --- Artefacts de build Python ---
# Créés si on fait "pip install -e ." ou "python setup.py build"
*.egg-info/
dist/
build/
